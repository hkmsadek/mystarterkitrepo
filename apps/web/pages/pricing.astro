---
import BaseLayout from '#layouts/BaseLayout.astro';
import { Button, Card, CardContent, CardDescription, CardHeader, CardTitle } from '@repo/ui';

const title = 'Pricing - SteadyMind';
const description = 'Start free. Upgrade for every programme, or add one-to-one coaching.';

const plans = [
  {
    name: 'Free',
    price: '$0',
    period: 'forever',
    description: 'A real programme, not a teaser',
    features: ['The Sleep Reset programme', 'Blog and weekly letter', 'Dashboard to keep your place'],
    cta: 'Start free',
    href: '/signup',
    variant: 'outline' as const,
  },
  {
    name: 'Guided',
    price: '$29',
    period: 'per month',
    description: 'Every programme, at your own pace',
    popular: true,
    features: ['All programmes, current and new', 'Weekly reflection prompts', 'Progress tracking', 'Cancel any time'],
    cta: 'Start Guided',
    href: '/signup',
    variant: 'default' as const,
  },
  {
    name: 'Coaching',
    price: '$149',
    period: 'per month',
    description: 'Guided, plus a coach in your corner',
    features: ['Everything in Guided', 'Two 45-minute sessions a month', 'Messaging between sessions', 'A personal plan after each programme'],
    cta: 'Talk to a coach',
    href: '/signup',
    variant: 'outline' as const,
  },
];
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-bold tracking-tight mb-6">Simple pricing</h1>
      <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
        The free plan is a complete programme. Pay only when you want more of them, or a coach.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16 max-w-5xl mx-auto">
      {plans.map((plan) => (
        <Card className={plan.popular ? 'border-primary shadow-lg relative' : ''}>
          {plan.popular && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2">
              <span class="bg-primary text-primary-foreground text-xs font-semibold px-3 py-1 rounded-full">MOST POPULAR</span>
            </div>
          )}
          <CardHeader>
            <CardTitle className="text-2xl">{plan.name}</CardTitle>
            <CardDescription>{plan.description}</CardDescription>
            <div class="mt-4">
              <span class="text-4xl font-bold">{plan.price}</span>
              <span class="text-muted-foreground ml-2">{plan.period}</span>
            </div>
          </CardHeader>
          <CardContent>
            <ul class="space-y-3 mb-6">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2 text-sm">
                  <span class="text-primary mt-0.5">&#10003;</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <Button variant={plan.variant} className="w-full" asChild>
              <a href={plan.href} data-astro-reload>{plan.cta}</a>
            </Button>
          </CardContent>
        </Card>
      ))}
    </div>

    <p class="text-center text-sm text-muted-foreground max-w-2xl mx-auto">
      Coaching is not therapy. If you need clinical care, a coach will say so and help you find it. Prices are placeholders until billing is switched on.
    </p>
  </div>
</BaseLayout>
