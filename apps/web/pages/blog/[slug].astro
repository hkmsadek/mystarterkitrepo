---
// Rendered on request; see `index.astro` in this directory.
export const prerender = false;

import { TRPCClientError } from '@trpc/client';

import BaseLayout from '#layouts/BaseLayout.astro';
import { api } from '../../lib/api';

const { slug } = Astro.params;

let post;
try {
  post = await api(Astro.request, Astro.locals.cfContext).blog.bySlug.query({ slug: slug ?? '' });
} catch (error) {
  // Unknown or unpublished slug. Anything else is a real failure and should
  // surface as a 500 rather than a misleading "not found".
  const status = error instanceof TRPCClientError ? error.data?.httpStatus : undefined;
  if (status === 404 || status === 400) {
    return new Response('Post not found', { status: 404 });
  }
  throw error;
}

Astro.response.headers.set('Cache-Control', 'public, max-age=60');

const paragraphs = post.content.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const dateFormat = new Intl.DateTimeFormat('en', { dateStyle: 'long' });
---

<BaseLayout title={`${post.title} - Starterkit SaaS`} description={post.excerpt}>
  <article class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="container mx-auto max-w-3xl">
      <a href="/blog" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
        &larr; All posts
      </a>
      <h1 class="text-4xl font-bold tracking-tight mt-4 mb-2">{post.title}</h1>
      {post.publishedAt && (
        <time datetime={new Date(post.publishedAt).toISOString()} class="text-sm text-muted-foreground">
          {dateFormat.format(new Date(post.publishedAt))}
        </time>
      )}
      <div class="mt-8 space-y-5 text-lg leading-relaxed">
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </article>
</BaseLayout>
