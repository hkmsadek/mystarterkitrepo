---
import BaseLayout from '#layouts/BaseLayout.astro';
import { Button } from '@repo/ui';

const pillars = [
  {
    title: 'Short, structured programmes',
    body: 'Two to four weeks each. One lesson a day, ten to twenty minutes, with a single practice to try before the next.',
  },
  {
    title: 'Evidence over trends',
    body: 'Cognitive behavioural techniques, sleep science, and acceptance-based tools. Nothing you will have to unlearn later.',
  },
  {
    title: 'A coach when you want one',
    body: 'Self-paced by default. Add one-to-one sessions when a programme stalls or life gets loud.',
  },
];

const steps = [
  { n: '1', title: 'Pick a programme', body: 'Start with what hurts most: sleep, worry, stress at work, or running on empty.' },
  { n: '2', title: 'Do one lesson a day', body: 'Short reads and one practice. Your dashboard keeps your place.' },
  { n: '3', title: 'Keep what works', body: 'Each programme ends with a plan you wrote, for the weeks after it.' },
];
---

<BaseLayout>
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-background to-muted/30">
    <div class="container mx-auto max-w-4xl text-center">
      <p class="text-sm font-medium uppercase tracking-wider text-primary mb-4">Mental health coaching</p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
        Feel steadier, one week at a time.
      </h1>
      <p class="text-xl text-muted-foreground mb-8 max-w-2xl mx-auto">
        Practical programmes for stress, sleep, anxiety and burnout, built on evidence and paced for a full life. Self-guided, with a coach when you need one.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" asChild>
          <a href="/courses">Browse programmes</a>
        </Button>
        <Button size="lg" variant="outline" asChild>
          <a href="/signup">Start free</a>
        </Button>
      </div>
      <p class="mt-4 text-sm text-muted-foreground">Free programme included. No card needed.</p>
    </div>
  </section>

  <section class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="container mx-auto max-w-5xl grid gap-8 md:grid-cols-3">
      {pillars.map((p) => (
        <div class="rounded-xl border bg-card p-6">
          <h2 class="text-lg font-semibold mb-2">{p.title}</h2>
          <p class="text-muted-foreground">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-muted/30">
    <div class="container mx-auto max-w-5xl">
      <h2 class="text-3xl font-bold tracking-tight text-center mb-12">How it works</h2>
      <ol class="grid gap-8 md:grid-cols-3">
        {steps.map((s) => (
          <li class="flex gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground font-semibold">{s.n}</span>
            <div>
              <h3 class="font-semibold mb-1">{s.title}</h3>
              <p class="text-muted-foreground">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="container mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold tracking-tight mb-4">Not sure where to start?</h2>
      <p class="text-lg text-muted-foreground mb-8">
        The blog has short, honest pieces on the things people bring to coaching most. Read a few, then pick the programme that sounds like your week.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" variant="outline" asChild><a href="/blog">Read the blog</a></Button>
        <Button size="lg" asChild><a href="/courses">See programmes</a></Button>
      </div>
    </div>
  </section>
</BaseLayout>
