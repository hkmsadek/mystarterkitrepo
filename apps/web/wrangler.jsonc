{
  "$schema": "../../node_modules/wrangler/config-schema.json",

  // [METADATA]
  // Edge router that receives all traffic and routes to api/app via service bindings.
  "name": "starterkitsaas-web",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-08",
  // Required by the Astro Cloudflare adapter, which renders on-demand pages
  // inside this worker.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },

  // [ASSETS]
  // Prerendered pages and static files. The Astro adapter sets the directory
  // (`dist/client`) in the config it emits to `dist/server/wrangler.json`,
  // which is what gets deployed; naming one here would shadow Astro's dev
  // server for prerendered routes.
  "assets": {
    "binding": "ASSETS",
    // Force worker execution for "/" to enable auth-aware routing
    // See docs/adr/001-auth-hint-cookie.md
    "run_worker_first": ["/"]
  },

  // [SERVICE BINDINGS]
  // Connect to other workers for dynamic routing.
  // NOTE: services is non-inheritable – must be specified per environment.
  // Use naming convention: <worker>-<env> (e.g., example-app-staging)
  "services": [
    { "binding": "APP_SERVICE", "service": "starterkitsaas-app" },
    { "binding": "API_SERVICE", "service": "starterkitsaas-api" }
  ],

  // [ENV:PRODUCTION]
  // Command: bun wrangler deploy --env=""
  //
  // Served from the free workers.dev address (`workers_dev: true` above). To
  // attach a custom domain, add a `routes` entry here: this worker is the
  // origin for the whole hostname, so Wrangler creates the DNS record and
  // certificate. The pattern must be a bare hostname – no "/*", no zone_name.
  //   "routes": [{ "pattern": "example.com", "custom_domain": true }],
  "vars": {
    "ENVIRONMENT": "production"
  },

  "env": {
    // [ENV:DEVELOPMENT]
    // Named Wrangler development environment; `bun dev` uses Astro instead.
    "dev": {
      "services": [
        { "binding": "APP_SERVICE", "service": "starterkitsaas-app-dev" },
        { "binding": "API_SERVICE", "service": "starterkitsaas-api-dev" }
      ],
      "vars": {
        "ENVIRONMENT": "development"
      }
    },

    // [ENV:STAGING]
    // Command: bun wrangler deploy --env staging
    "staging": {
      "services": [
        { "binding": "APP_SERVICE", "service": "starterkitsaas-app-staging" },
        { "binding": "API_SERVICE", "service": "starterkitsaas-api-staging" }
      ],
      "vars": {
        "ENVIRONMENT": "staging"
      },
      // oxfmt-ignore
      "routes": [
        { "pattern": "staging.example.com", "custom_domain": true }
      ]
    }
  }
}
