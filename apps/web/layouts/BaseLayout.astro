---
import '#styles/globals.css';

import { ClientRouter } from 'astro:transitions';

import { SessionMenu } from '../components/SessionMenu';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'SteadyMind - Mental health coaching that fits your week',
  description = 'Short, practical programmes and one-to-one coaching for stress, sleep, anxiety and burnout. Built on evidence, delivered at your pace.',
  image = '/logo512.png'
} = Astro.props;

const nav = [
  { href: '/courses', label: 'Programmes' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/pricing', label: 'Pricing' },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site ?? Astro.url)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site ?? Astro.url)} />

    {/* Client-side navigation between marketing pages: the next page is
        fetched and swapped in with a view transition, so links feel instant
        while every URL remains a complete, indexable document. Links into the
        app carry `data-astro-reload`, since the app is a separate bundle that
        must load as a real document. */}
    <ClientRouter />
  </head>
  <body>
    <div class="min-h-screen flex flex-col">
      <header class="border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 sticky top-0 z-40">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex h-16 items-center justify-between gap-6">
            <a href="/" class="flex items-center gap-2 text-lg font-bold text-primary">
              <img src="/logo192.png" alt="" class="h-7 w-7" />
              SteadyMind
            </a>
            <nav class="hidden md:flex items-center gap-6">
              {nav.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    'text-sm font-medium transition-colors hover:text-foreground',
                    current.startsWith(item.href) ? 'text-foreground' : 'text-muted-foreground',
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </nav>
            {/* Persisted across page swaps so the session is fetched once. */}
            <SessionMenu client:load transition:persist />
          </div>
        </div>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="border-t bg-background/95">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-10">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <div class="space-y-3 md:col-span-2">
              <h3 class="font-semibold">SteadyMind</h3>
              <p class="text-sm text-muted-foreground max-w-md">
                Coaching for the ordinary hard parts of life: stress, sleep, worry, and the slow burn of too much. Practical, paced, and private.
              </p>
              <p class="text-xs text-muted-foreground max-w-md">
                SteadyMind is coaching, not therapy or medical care. If you are in crisis or thinking about harming yourself, contact your local emergency services or a crisis line now.
              </p>
            </div>
            <div class="space-y-3">
              <h4 class="font-medium">Explore</h4>
              <ul class="space-y-2 text-sm text-muted-foreground">
                <li><a href="/courses" class="hover:text-foreground transition-colors">Programmes</a></li>
                <li><a href="/blog" class="hover:text-foreground transition-colors">Blog</a></li>
                <li><a href="/pricing" class="hover:text-foreground transition-colors">Pricing</a></li>
                <li><a href="/about" class="hover:text-foreground transition-colors">About</a></li>
              </ul>
            </div>
            <div class="space-y-3">
              <h4 class="font-medium">Account</h4>
              <ul class="space-y-2 text-sm text-muted-foreground">
                <li><a href="/login" data-astro-reload class="hover:text-foreground transition-colors">Log in</a></li>
                <li><a href="/signup" data-astro-reload class="hover:text-foreground transition-colors">Create account</a></li>
                <li><a href="/dashboard" data-astro-reload class="hover:text-foreground transition-colors">Dashboard</a></li>
              </ul>
            </div>
          </div>
          <p class="mt-8 text-xs text-muted-foreground">&copy; {new Date().getFullYear()} SteadyMind</p>
        </div>
      </footer>
    </div>
  </body>
</html>
